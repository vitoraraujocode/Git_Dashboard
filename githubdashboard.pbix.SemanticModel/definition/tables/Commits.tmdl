		annotation SummarizationSetBy = Automatic

	column Ano = VALUE(LEFT(Commits[data], 4))
		dataType: int64
		formatString: 0
		lineageTag: fe711d79-949f-4eb8-a924-ff4d1ca83b12
		summarizeBy: none

	partition Commits = m
		mode: import
		source =
				let
				    Fonte = Git,
				
				    BuscarCommits = Table.AddColumn(
				        Fonte,
				        "DadosCommits",
				        each
				            let
				                NomeRepositorio = [name],
				
				                Resposta = Json.Document(
				                    Web.Contents(
				                        "https://api.github.com",
				                        [
				                            RelativePath =
				                                "repos/vitoraraujocode/"
				                                & NomeRepositorio
				                                & "/commits",
				                            Query = [
				                                per_page = "100",
				                                page = "1"
				                            ]
				                        ]
				                    )
				                )
				            in
				                Resposta
				    ),
				
				    ExpandirLista = Table.ExpandListColumn(
				        BuscarCommits,
				        "DadosCommits"
				    ),
				
				    ExpandirCommit = Table.ExpandRecordColumn(
				        ExpandirLista,
				        "DadosCommits",
				        {"commit"},
				        {"commit"}
				    ),
				
				    ExpandirDetalhes = Table.ExpandRecordColumn(
				        ExpandirCommit,
				        "commit",
				        {"message", "committer"},
				        {"mensagem", "committer"}
				    ),
				
				    ExpandirData = Table.ExpandRecordColumn(
				        ExpandirDetalhes,
				        "committer",
				        {"date"},
				        {"data"}
				    ),
				
				    Resultado = Table.SelectColumns(
				        ExpandirData,
				        {
				            "id",
				            "name",
				            "mensagem",
				            "data"
				        }
				    ),
				
				    Renomear = Table.RenameColumns(
				        Resultado,
				        {
				            {"id", "id_repositorio"},
				            {"name", "repositorio"}
				        }
				    ),
				
				    Agrupar = Table.Group(
				        Renomear,
				        {"id_repositorio"},
				        {
				            {
				                "Dados",
				                each Table.AddIndexColumn(
				                    Table.Sort(_, {{"data", Order.Ascending}}),
				                    "commit",
				                    1,
				                    1,
				                    Int64.Type
				                )
				            }
				        }
				    ),
				
				    Expandir = Table.ExpandTableColumn(
				        Agrupar,
				        "Dados",
				        {"repositorio", "mensagem", "data", "commit"}
				    )
				in
				    Expandir

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

